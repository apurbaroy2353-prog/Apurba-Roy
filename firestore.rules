rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isNonAnonymous() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Projects collection: client selection projects created by photographer
    match /projects/{projectId} {
      // Both photographer and anonymous client with gallery link can read project details
      allow read: if isAuthenticated();

      // Only photographers can create projects
      allow create: if isAuthenticated();

      // Clients and photographers can update (selections count, status, submission)
      allow update: if isAuthenticated();

      // Only authenticated admin (non-anonymous) can delete a project
      allow delete: if isNonAnonymous();

      // Photos subcollection for a project
      match /photos/{photoId} {
        allow read: if isAuthenticated();
        // Only admin can upload/modify photo records
        allow write: if isNonAnonymous();
      }

      // Selections subcollection for a project
      match /selections/{photoId} {
        // Both client and admin can read, write, and delete selection items
        allow read, write: if isAuthenticated();
      }

      // Selection history subcollection for a project (enables undo/redo & history review)
      match /selection_history/{historyId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Photographer Profiles: stores admin Google Drive connection & token securely
    match /photographerProfiles/{uid} {
      // Strictly restricted to the photographer themselves
      allow read, write: if isOwner(uid);
    }

    // Customer Galleries collection (legacy & synced support)
    match /customerGalleries/{galleryId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isNonAnonymous();

      match /photos/{photoId} {
        allow read: if true;
        allow write: if isNonAnonymous();
      }

      match /selections/{selectionId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Client Gallery Sessions collection (recovery codes and persistent client metadata)
    match /clientGallerySessions/{sessionId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isNonAnonymous();

      match /selections/{photoId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Global default-deny catch-all for any unknown collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
