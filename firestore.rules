rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isAuthenticated() && request.auth.uid == ownerUid;
    }

    // Customer Galleries collection
    match /customerGalleries/{galleryId} {
      // Photographers can read their own galleries, customers can read active/submitted/draft galleries without login
      allow read: if true;

      // Photographers can create galleries if authenticated, or open creation for local/demo setup
      allow create: if isAuthenticated() || true;

      // Photographers can update anything; customers can update selection fields without auth
      allow update: if isAuthenticated() || (
        // Customers updating selections/status on active gallery
        resource.data.status != 'disabled' && resource.data.status != 'locked'
      );

      // Only authenticated owner can delete
      allow delete: if isAuthenticated();

      // Selections subcollection
      match /selections/{selectionId} {
        allow read: if true;
        allow write: if true;
      }

      // Photos subcollection
      match /photos/{photoId} {
        allow read: if true;
        allow write: if isAuthenticated() || true;
      }
    }

    // Default catch-all for existing collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
